# cp .env.example .env
# The passwords go into redis:// URLs, so keep them URL-safe. They are only read on first boot.
VALKEY_ADMIN_PASSWORD=change-me-admin
VALKEY_APP_PASSWORD=change-me-app
# The VPN address of this host (Tailscale / WireGuard). Do not use 0.0.0.0.
VALKEY_BIND_ADDR=100.64.0.1
VALKEY_PORT=6379
# At least the used_memory of the Redis being moved here.
VALKEY_MAXMEMORY=1gb
